{
  "name": "univer-cli-workspace",
  "private": true,
  "homepage": "https://github.com/dream-num/univer-cli",
  "bugs": {
    "url": "https://github.com/dream-num/univer-cli/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-num/univer-cli.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter univer-cli build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:locales && pnpm test && pnpm --filter univer-cli pack:check",
    "check:locales": "pnpm --filter @univer/render-preset check:locales && pnpm --filter @univer/collab-web check:locales",
    "dev": "pnpm --filter univer-cli dev",
    "link:cli": "pnpm --filter univer-cli link:cli",
    "unlink:cli": "pnpm --filter univer-cli unlink:cli",
    "update:sdk": "node scripts/update-sdk-dependencies.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "start": "pnpm --filter univer-cli start",
    "release:cli": "node scripts/release/release-cli.mjs",
    "release:validate-skills": "node scripts/release/validate-skill-distribution.mjs",
    "test": "pnpm build && vitest run --exclude '.worktrees/**' test/*.test.ts && pnpm --filter './apps/**' --filter './packages/**' -r --if-present test",
    "typecheck": "pnpm --filter './apps/**' --filter './packages/**' -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
