  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Univer Browser View content plugin, UI stylesheet, locale, and rendering preset.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": {
      "default": "./src/styles.ts"
    },
    "./styles.css": {
      "default": "./src/styles.css"
    },
    "./facades": {
      "default": "./src/facades.ts"
    },
    "./machine-locale": {
      "types": "./src/machine-locale.ts",
      "default": "./src/machine-locale.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "generate:locales": "node scripts/generate-content-locales.mjs",
    "check:locales": "node scripts/generate-content-locales.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit --pretty false"
  },
