{
  "name": "@univer/collab-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "SDK-backed collaboration gateway for path-addressed .univer files, Worktrees, Snapshot/Comb endpoints and Viewer hosting.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit --pretty false"
  },
  "dependencies": {
    "@univer/collab-gateway-contract": "workspace:*",
    "@univer/univerfile-sqlite": "workspace:*",
    "@univerjs-pro/bases": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/boards": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration-endpoint": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration-service": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration-transport-node": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration-worktree-endpoint": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration-worktree-service": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/embed": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/slides": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/core": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/docs": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/drawing": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/engine-formula": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/engine-render": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/protocol": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/sheets": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs/sheets-drawing": "1.0.0-insiders.20260813-30ff2fe",
    "busboy": "^1.6.0",
    "libsql": "^0.5.29",
    "sirv": "^3.0.2",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/ws": "^8.18.1",
    "@univerjs-pro/collaboration-client": "1.0.0-insiders.20260813-30ff2fe",
    "@univerjs-pro/collaboration-client-node": "1.0.0-insiders.20260813-30ff2fe"
  }
}
