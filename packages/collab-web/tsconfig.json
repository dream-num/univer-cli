{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true
  },
  "include": ["src", "vite.config.ts", "vite-shared.ts"]
}
